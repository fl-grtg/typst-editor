HOST=127.0.0.1 # Parsed config value; local commands pin 127.0.0.1. Compose sets HOST=0.0.0.0; keep that for published ports.
PORT=8978 # Parsed config value; local commands pin 8978. Compose ignores this and pins 8978; change environment.PORT and ports in compose.yml together.
DATA_DIR=./data # SQLite + files directory (local Python; Compose forces /app/data).
FONTS_DIR= # Optional server-wide font directory (or OS path-separated list) of .ttf/.otf/.ttc/.otc files. Empty = auto-detect DATA_DIR/fonts, /usr/local/fonts, /usr/local/share/fonts, /usr/share/fonts.
TRUST_PROXY=false # Trust X-Forwarded-Proto/For from the reverse proxy. Set in config.toml or here; env wins.
FORWARDED_ALLOW_IPS=127.0.0.1,::1 # App gate + uvicorn --forwarded-allow-ips (Dockerfile passes the same env): peers allowed to send X-Forwarded-* (comma-separated, CIDR ok). Behind compose/Caddy on a bridge network extend (not replace) the default, e.g. 127.0.0.1,::1,172.16.0.0/12, else proxy headers are ignored and all clients share one rate-limit bucket. Never '*' with TRUST_PROXY=true (refuses to start).
COOKIE_SECURE=auto # auto|true|false.
REGISTRATION=invite-only # closed|invite-only|open. open only for local tests, never on the public internet.
REGISTRATION_INVITE_TOKEN= # Invite code for accounts after the first; if set, even the first account needs it. Set before first start on public servers. Min 16 chars (generate: openssl rand -hex 32); a shorter non-empty value refuses to start. Empty + fresh DATA_DIR: entrypoint generates one (see logs, stored chmod 600 as DATA_DIR/.invite_token).
OIDC_ISSUER_URL= # OIDC issuer URL (e.g. https://auth.example.com/application/o/typst/). Leave empty to disable OIDC login.
OIDC_CLIENT_ID= # OIDC client ID (both OIDC_ISSUER_URL and OIDC_CLIENT_ID must be set to enable OIDC).
OIDC_CLIENT_SECRET= # OIDC client secret (leave empty for public PKCE clients).
OIDC_REDIRECT_URI= # Optional explicit callback URL (e.g. https://typst.example.com/api/oidc/callback). Auto-derived if empty.
OIDC_PROVIDER_NAME=SSO # Display label for the SSO sign-in button (e.g. Authentik, Authelia, Kanidm).
OIDC_SCOPES=openid profile email # Space-separated OIDC scopes.
OIDC_USERNAME_CLAIM=preferred_username # ID token / userinfo claim used to seed new usernames.
OIDC_ALLOWED_GROUPS= # Optional comma-separated list of groups allowed to sign in via OIDC.
OIDC_AUTO_REGISTER=true # Automatically create accounts on first OIDC login (independent of REGISTRATION).
OIDC_AUTO_REDIRECT=false # Automatically redirect signed-out visitors to the OIDC provider.
DISABLE_PASSWORD_LOGIN=false # Disable local username/password login and registration (requires OIDC to be configured).
SESSION_SECONDS=1209600 # Session lifetime in seconds (14 days).
MAX_DOCS_PER_USER=100 # Max docs per user.
MAX_BYTES_PER_USER=524288000 # Max storage bytes per user (500 MB).
MAX_FILES_PER_DOC=1000 # Max files per project (name kept for old configs).
RATE_LOGIN_PER_MIN=10 # Login attempts per minute.
RATE_REGISTER_PER_HOUR=20 # Registrations per hour.
RATE_AUTH_PER_MIN=180 # Auth checks per minute (logout/me).
RATE_JOIN_PER_MIN=30 # Invite redemptions per minute.
RATE_READ_PER_MIN=60 # Account-less read-link views per minute (per IP + per token buckets).
RATE_SEARCH_PER_MIN=120 # Searches per minute.
RATE_FILES_PER_MIN=60 # File uploads and deletions per minute.
RATE_FILE_READ_PER_MIN=600 # Attachment downloads per minute (including preview inputs).
RATE_FILES_LIST_PER_MIN=600 # File list refreshes per minute.
RATE_SIDEBAR_PER_MIN=300 # Sidebar refresh requests per minute.
RATE_SAVE_PER_MIN=90 # Doc saves per minute.
RATE_COMMENTS_PER_MIN=120 # Comment writes per minute.
RATE_EXPORT_PER_MIN=10 # ZIP exports per minute.
RATE_EXPORT_DOC_PER_MIN=30 # Per-doc exports per minute (pdf/svg/png/zip, own bucket, isolated from full backup export).
RATE_PW_PER_MIN=10 # Password changes per minute.
RATE_INVITE_PER_MIN=10 # Invite creations per minute.
RATE_SHARE_PER_MIN=20 # Share changes per minute.
RATE_SNAPSHOTS_PER_MIN=120 # Snapshot reads and writes per minute.
RATE_CREATE_PER_MIN=60 # Doc creations per minute.
RATE_DUPLICATE_PER_MIN=30 # Doc duplications per minute.
RATE_AVATAR_PER_MIN=20 # Avatar uploads per minute.
RATE_FOLDERS_PER_MIN=60 # Folder operations per minute.
RATE_KEYS_PER_MIN=60 # API key management per minute.
RATE_MCP_PER_MIN=240 # MCP tool calls per minute.
RATE_RENAME_PER_MIN=60 # Doc renames per minute (own bucket, no longer shares save).
RATE_DELETE_PER_MIN=60 # Doc deletes per minute (own bucket, no longer shares save).
RATE_RESTORE_PER_MIN=60 # Doc restores per minute (own bucket, no longer shares save).
RATE_MOVE_PER_MIN=60 # Doc moves per minute (own bucket, no longer shares files).
RATE_TEMPLATES_PER_MIN=90 # Template saves/deletes/moves per minute (own bucket, no longer shares save/files).
RATE_TPLFOLDERS_PER_MIN=60 # Template folder ops per minute (own bucket, no longer shares files).
# Full table: see backend/config.py (single source of truth for file+env parsing).
