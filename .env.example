HOST=127.0.0.1 # Bind address.
PORT=8978 # HTTP port. Compose maps 127.0.0.1:${PORT:-8978}:${PORT:-8978} (host:container); changing PORT moves both.
DATA_DIR=./data # SQLite + files directory.
# COMPOSE_DATA_PATH=./data # Optional: host path instead of the managed volume, e.g. /srv/typst/data (needs chown -R 999:999).
TRUST_PROXY=false # Trust X-Forwarded-Proto/For from the reverse proxy. Set in config.toml or here; env wins.
# FORWARDED_ALLOW_IPS=127.0.0.1,::1 # Uvicorn trusted proxy IPs (comma-separated, CIDR ok). Behind compose/Caddy on a bridge network extend (not replace) the default, e.g. 127.0.0.1,::1,172.16.0.0/12, else X-Forwarded-For/Proto is ignored and all clients share one rate-limit bucket. Never '*' with TRUST_PROXY=true.
COOKIE_SECURE=auto # auto|true|false.
REGISTRATION=invite-only # closed|invite-only|open. open only for local tests, never on the public internet.
REGISTRATION_INVITE_TOKEN= # Invite code for accounts after the first; if set, even the first account needs it. Set before first start on public servers. Min 16 chars (generate: openssl rand -hex 32); a shorter non-empty value refuses to start. Empty + fresh DATA_DIR: entrypoint generates one (see logs, stored chmod 600 as DATA_DIR/.invite_token).
SESSION_SECONDS=1209600 # Session lifetime in seconds (14 days).
MAX_DOCS_PER_USER=100 # Max docs per user.
MAX_BYTES_PER_USER=524288000 # Max storage bytes per user (500 MB).
MAX_FILES_PER_DOC=200 # Max files per doc.
RATE_LOGIN_PER_MIN=10 # Login attempts per minute.
RATE_REGISTER_PER_HOUR=20 # Registrations per hour.
RATE_AUTH_PER_MIN=60 # Auth checks per minute (logout/me).
RATE_JOIN_PER_MIN=30 # Invite redemptions per minute.
RATE_SEARCH_PER_MIN=60 # Searches per minute.
RATE_FILES_PER_MIN=20 # File up- and downloads per minute.
RATE_FILES_LIST_PER_MIN=120 # File list refreshes per minute.
RATE_SAVE_PER_MIN=30 # Doc saves per minute.
RATE_COMMENTS_PER_MIN=30 # Comment writes per minute.
RATE_EXPORT_PER_MIN=5 # ZIP exports per minute.
RATE_PW_PER_MIN=10 # Password changes per minute.
RATE_INVITE_PER_MIN=10 # Invite creations per minute.
RATE_SHARE_PER_MIN=10 # Share changes per minute.
RATE_SNAPSHOTS_PER_MIN=60 # Snapshot reads and writes per minute.
RATE_CREATE_PER_MIN=20 # Doc creations per minute.
RATE_DUPLICATE_PER_MIN=10 # Doc duplications per minute.
RATE_AVATAR_PER_MIN=10 # Avatar uploads per minute.
RATE_FOLDERS_PER_MIN=20 # Folder operations per minute.
# Full table: see backend/config.py (single source of truth for file+env parsing).
